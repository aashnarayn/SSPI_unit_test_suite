			 subifc_io_miso_out,
			 subifc_io_ncs_outen,
			 subifc_io_ncs_out,
			 subifc_io_ncs_in,
			 mav_read_req,
			 rl_mi_qualification,
			 rl_si_qualification,
			 rl_spi_clock_generator_master_mode,
			 rl_spi_clock_generator_slave_mode,
			 rl_tx_fifo_threshold_updates,
			 rl_rx_fifo_threshold_updates,
			 rl_transfer_data_from_txreg_to_txfifo,
			 rl_transfer_data_from_rxfifo_to_rxreg,
			 rl_set_up_time,
			 rl_chip_select_control_master_mode,
			 rl_chip_select_control_slave_mode,
			 rl_transmit_idle_to_data_transfer,
			 rl_transmit_state,
			 rl_receive_idle_to_data_receive,
			 rl_receive_state,
